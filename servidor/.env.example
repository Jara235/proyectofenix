# ============================================================
# Proyecto Fénix — Variables de Entorno
# COPIA ESTE ARCHIVO COMO  .env  (sin el .example)
# NUNCA subas el .env real a un repositorio
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=fenix_db
POSTGRES_USER=fenix_admin
# ⚠️ CAMBIA ESTA CONTRASEÑA antes de instalar
POSTGRES_PASSWORD=Fenix2026_GT_Seguro!

# --- n8n ---
# En DEV: el subdominio que Cloudflare Tunnel te asigne (ej: fenix-gt.trycloudflare.com)
# En PROD: tu dominio propio (ej: n8n.grupotrujano.com.mx)
N8N_HOST=REEMPLAZAR_CON_TU_DOMINIO_DE_CLOUDFLARE
N8N_ADMIN_USER=admin
# ⚠️ CAMBIA ESTA CONTRASEÑA antes de instalar
N8N_ADMIN_PASSWORD=N8n_Fenix_Admin2026!

# --- Gemini API (Google AI Studio) ---
# Obtén tu llave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REEMPLAZAR_CON_TU_API_KEY_DE_GEMINI
